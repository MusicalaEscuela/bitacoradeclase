rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : "";
    }

    function profileData() {
      return firestore.get(
        /databases/(default)/documents/users/$(authEmail())
      ).data;
    }

    function accessRole() {
      return profileData().get('role', '').lower();
    }

    function accessIsActive() {
      return profileData().get('active', true) != false;
    }

    function linkedStudentIds() {
      return profileData().get('studentIds',
        profileData().get('students',
          [profileData().get('studentId',
            profileData().get('studentKey',
              profileData().get('estudianteId', '')))]));
    }

    function isAdminRole(role) {
      return role in [
        "admin", "administrator", "administrador", "administradora",
        "administrative", "administrativo", "administrativa", "direction",
        "direccion", "dirección"
      ];
    }

    function isTeacherRole(role) {
      return role in ["teacher", "docente", "profesor", "profesora"];
    }

    function isAdmin() {
      return isSignedIn() && isAdminRole(accessRole()) && accessIsActive();
    }

    function isTeacher() {
      return isSignedIn() &&
        isTeacherRole(accessRole()) &&
        accessIsActive();
    }

    function isActiveStudent() {
      return isSignedIn() &&
        accessRole() in ["student", "estudiante", "acudiente", "guardian", "parent"] &&
        accessIsActive() &&
        linkedStudentIds().size() > 0;
    }

    function isAllowedFile() {
      return request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|video/.*|audio/.*|application/pdf');
    }

    match /bitacoras/{studentId}/{allPaths=**} {
      allow read: if isAdmin() || isTeacher() ||
        (isActiveStudent() && studentId in linkedStudentIds());
      allow create, update: if (isAdmin() || isTeacher()) && isAllowedFile();
      allow delete: if isAdmin() || isTeacher();
    }

  }
}
